 357          // Set cursor to specific page and column
 358          void oled_set_cursor(unsigned char page, unsigned char col) {
 359   1          oled_write_command(0xB0 + (page & 0x07));  // Set page (0-7)
 360   1          oled_write_command(0x00 + (col & 0x0F));   // Set lower column
 361   1          oled_write_command(0x10 + ((col >> 4) & 0x0F));  // Set upper column
 362   1      }
