 140          // Write command to OLED
 141          void oled_write_command(unsigned char cmd) {
 142   1          i2c_start();
 143   1          i2c_send_byte(OLED_ADDR);  // OLED address + write bit
 144   1          i2c_send_byte(0x00);        // Command byte (0x00 = command, 0x40 = data)
 145   1          i2c_send_byte(cmd);         // Command
 146   1          i2c_stop();
 147   1      }
 148          
 149          // Write data to OLED
 150          void oled_write_data(unsigned char val) {
 151   1          i2c_start();
