   7          // I2C delay for timing
   8          void i2c_delay(void) {
   9   1          unsigned char i;
  10   1          for(i = 0; i < 10; i++);
  11   1      }
  12          
  13          // I2C Start Condition
  14          // SDA goes LOW while SCL is HIGH
  15          void i2c_start(void) {
  16   1          SDA = 1;
  17   1          SCL = 1;
  18   1          i2c_delay();
  19   1          SDA = 0;  // START condition
  20   1          i2c_delay();
  21   1          SCL = 0;
  22   1          i2c_delay();
  23   1      }
  24          
  25          // I2C Stop Condition
  26          // SDA goes HIGH while SCL is HIGH
  27          void i2c_stop(void) {
  28   1          SCL = 0;
  29   1          SDA = 0;
  30   1          i2c_delay();
  31   1          SCL = 1;
  32   1          i2c_delay();
  33   1          SDA = 1;  // STOP condition
  34   1          i2c_delay();
  35   1      }
  36          
  37          // I2C Acknowledge
  38          void i2c_ack(void) {
  39   1          SCL = 0;
  40   1          SDA = 0;  // Pull SDA low
  41   1          i2c_delay();
