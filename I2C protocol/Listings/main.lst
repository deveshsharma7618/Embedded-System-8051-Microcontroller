  60          // Send a byte over I2C
  61          unsigned char i2c_send_byte(unsigned char byte) {
  62   1          unsigned char i, ack;
  63   1          
  64   1          for(i = 0; i < 8; i++) {
  65   2              SCL = 0;
  66   2              i2c_delay();
  67   2              
  68   2              if(byte & 0x80)
  69   2                  SDA = 1;  // Send bit 1
  70   2              else
  71   2                  SDA = 0;  // Send bit 0
  72   2              
  73   2              i2c_delay();
  74   2              SCL = 1;  // Clock pulse
  75   2              i2c_delay();
  76   2              byte <<= 1;
  77   2          }
  78   1          
  79   1          // Get ACK bit
  80   1          SCL = 0;
  81   1          SDA = 1;  // Release SDA
  82   1          i2c_delay();
  83   1          SCL = 1;
  84   1          i2c_delay();
  85   1          
  86   1          if(SDA == 0)
  87   1              ack = 1;  // ACK received
  88   1          else
  89   1              ack = 0;  // NACK received
  90   1          
  91   1          SCL = 0;
  92   1          i2c_delay();
  93   1          
  94   1          return ack;
  95   1      }
  96          
  97          // Receive a byte over I2C
  98          unsigned char i2c_receive_byte(unsigned char ack_flag) {
  99   1          unsigned char i, byte = 0x00;
 100   1          
 101   1          SDA = 1;  // Release SDA
 102   1          
 103   1          for(i = 0; i < 8; i++) {
 104   2              SCL = 0;
 105   2              i2c_delay();
 106   2              SCL = 1;
 107   2              i2c_delay();
 108   2              
 109   2              byte <<= 1;
 110   2              byte |= SDA;
 111   2              
 112   2              i2c_delay();
 113   2          }
 114   1          
 115   1          SCL = 0;
 116   1          i2c_delay();
